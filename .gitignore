# Track source code, service assets/configuration, and all docs by default.
# Keep reviewed outputs/ deliverables and their public evidence shareable.

# Local input data, analysis results, API responses, and run artifacts.
data/
runs/
region_monthly.csv

# Disposable working folders, linked dependencies, and Office lock files.
/tmp/
/temp/
node_modules/
~$*
*.tmp
*.temp
*.bak
*.orig
*.rej
*.swp
*.swo
*~

# Test code and test artifacts (keep local, do not publish).
test/
tests/
__tests__/
test_*.py
*_test.py
*_tests.py
conftest.py
*.test.js
*.test.ts
*.spec.js
*.spec.ts
/scripts/check_service.py
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage/
.tox/
.nox/

# Local credentials; the example configuration remains shareable.
.env
.env.*
!/config/.env.example
.secrets/
.credentials/
.netrc
_netrc
credentials.local.*
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore

# Python environments, caches, logs, and local databases.
.venv/
.venv-*/
venv/
env/
__pycache__/
*.py[cod]
.cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
logs/
*.log
*.db
*.db-*
*.sqlite*

# Generated packages and local editor/OS state.
build/
dist/
*.egg-info/
.eggs/
.idea/
.vscode/
*.code-workspace
.DS_Store
Thumbs.db
Desktop.ini
desktop.ini
