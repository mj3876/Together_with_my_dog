# Copy to .env; keep real credentials out of Git.
APP_MODE=live
DATABASE_PATH=data/app.db
KAKAO_REST_API_KEY=
KAKAO_MOBILITY_API_KEY=
LOCATION_SIGNING_KEY=
# Request budget prevents a large catalogue from causing unlimited paid API calls.
MAX_ROUTE_REQUESTS=500
MAX_SEARCH_STATES=250000
# Local demo: APP_MODE=demo. Fictional places/routes; separate in-memory database.
